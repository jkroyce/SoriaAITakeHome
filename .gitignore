# secrets -- never commit
.env

# local env
.venv/
__pycache__/
*.pyc

# local TLS workaround (machine-specific, not part of the deliverable)
certs/

# Raw HTML is large and regenerable via `make fetch`. The provenance sidecars
# (*.prov.json) ARE committed -- they are the audit trail: url, fetched_at, sha256.
raw/*.html
raw/index/*.html
raw/articles/*.html
raw/*.xml

# duckdb is a build product; exports are committed instead
data/*.duckdb

# agent worktrees are checkouts, not content
.claude/worktrees/
data/*.duckdb.wal
